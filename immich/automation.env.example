# Copy this file to automation.env and fill in real values:
#   cp automation.env.example automation.env
#
# These variables are consumed by the media-automation and cloudflared
# containers at runtime (via env_file: in docker-compose.override.yml) --
# NOT by docker-compose's own ${VAR} substitution. See docs/04-automation-setup.md.

# Cloudflare Tunnel connector token, from the Cloudflare Zero Trust dashboard
# (Networks -> Tunnels -> your tunnel -> Install connector). See docs/03-tunnel-setup.md.
CLOUDFLARE_TUNNEL_TOKEN=

# Immich API key, generated from Account Settings -> API Keys after logging
# in as the admin user (needs at least asset read access). See docs/04-automation-setup.md.
IMMICH_API_KEY=

# The Immich internal user id (UUID) of your own admin account -- uploads
# owned by this id are never copied into review-staging. Find it via
# GET {IMMICH_API_URL}/users/me with your API key. See docs/02-immich-setup.md step 5.
ADMIN_USER_ID=

# Shared secret the receiver checks on the X-Webhook-Secret header on every
# incoming webhook request. Make up any random string, and set the same
# value in Immich's Workflow "Trigger Webhook" action headers.
WEBHOOK_SHARED_SECRET=
