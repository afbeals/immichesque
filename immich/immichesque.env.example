# This project's one addition to Immich's own .env -- append it there:
#   cat immichesque.env.example >> .env
# then set the real path. This has to live in the plain .env file (not
# automation.env) because docker-compose only reads .env for ${VAR}
# substitution inside the compose files themselves. See
# docs/02-immich-setup.md for details.

# Absolute path to the review-staging directory from docs/01-drive-setup.md
# (NOT the immich_library directory -- that one is UPLOAD_LOCATION above).
REVIEW_STAGING_LOCATION=/mnt/disks/media_drive/review_staging
